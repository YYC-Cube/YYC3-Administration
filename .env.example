# ==========================================
# YYC³ My-Mgmt Environment Configuration
# ==========================================
# 注：仅保留源码真实消费的变量（2026-09-26 文档对齐）。
# 历史上文档化但从未被 import.meta.env 消费的变量已移除：
#   VITE_APP_TITLE / VITE_APP_VERSION / VITE_AI_API_BASE_URL /
#   VITE_GITHUB_API_BASE_URL / VITE_DEFAULT_THEME / VITE_DEFAULT_LANGUAGE /
#   VITE_ENABLE_DEV_TOOLS / VITE_ENABLE_ANALYTICS / VITE_ENABLE_ERROR_REPORTING /
#   VITE_CACHE_TTL / VITE_RATE_LIMIT_RPS / VITE_DEBUG_MODE / VITE_MOCK_API_DELAY

# ── 演示与测试 ───────────────────────────────────────────────────
# 演示一键登录（仅 DEV 构建生效，生产被 tree-shake）
VITE_GHOST_MODE=true

# E2E 自动登录旁路（由 playwright.config.ts webServer 自动注入，勿手动开启）
# VITE_E2E=true

# ── 演示假实时数据 ────────────────────────────────────────────────
# 是否在生产/预览构建中启用假实时数据(KPI 随机波动、通知活动流)。
# DEV 默认开启(本地可见实时效果);生产默认关闭,避免公网用户把随机
# 演示数据误认为真实业务数据(F-02)。需要在生产演示时才设为 true。
# VITE_ENABLE_MOCK=true

# ── AI 代理（生产必配）──────────────────────────────────────────
# 服务端 AI 代理地址（参考实现见 docs/design-references/）
# 未配置时：DEV 回落浏览器直连（仅限本地开发）；生产构建禁用带 key 的直连请求
# 注：配置后生产构建自动将其源注入 CSP connect-src（vite.config.ts csp-harden 插件）
# VITE_AI_PROXY_URL=https://your-proxy.example.com/ai-proxy

# ── Supabase 认证 + 数据面一期(P3-11.1/11.3)─────────────────────
# 两者齐备时同时激活:真实认证(PKCE)与设置云同步(user_settings,RLS)
# 建表见 supabase/migrations/0001_*.sql;激活步骤见
# docs/design-references/P3-DATA-PHASE1-RUNBOOK.md
# 缺省时应用完全回落本地演示模式,零影响
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# ==========================================
# WeChat Integration Configuration
# ==========================================
# 🔒 WARNING: These values are embedded at build time (VITE_ prefix).
#   For production, proxy sensitive keys through a backend service.
#   Never commit real credentials to version control.
# VITE_WECHAT_APP_ID=
# VITE_WECHAT_APP_SECRET=
# VITE_WECHAT_TOKEN=
# VITE_WECHAT_ENCODING_AES_KEY=

# ── 监控（预留，当前源码未消费；接入 Sentry/GA 时启用）──────────
# VITE_SENTRY_DSN=
# VITE_GA_TRACKING_ID=
