    "lit": "^3.3.3",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "re-resizable": "^6.11.2",
    "react": "18.3.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "7.18.3",
    "recharts": "3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@eslint/js": "^9.39.5",
