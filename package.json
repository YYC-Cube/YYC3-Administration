{
  "name": "@yyc3/my-mgmt",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "description": "YYC³ AI Marketing Automation Terminal - Enterprise Management Platform",
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3171 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "COV_ALL=1 vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 320 --ignore-pattern .next",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist build coverage .vite playwright-report test-results",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@supabase/supabase-js": "^2.117.2",
    "@yyc3/i18n-core": "^2.4.3",
