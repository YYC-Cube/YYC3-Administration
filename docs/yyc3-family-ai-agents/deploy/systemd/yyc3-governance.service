[Unit]
Description=YYC3 FAmily-AI Governance Hub
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
User=yyc3
Group=yyc3
Environment=GOVERNANCE_DB=/home/yyc3/.nemoclaw/governance/data/governance.db
Environment=GOVERNANCE_PORT=25700
Environment=PYTHONPATH=/home/yyc3/.nemoclaw/agents:/home/yyc3/.nemoclaw/memory
ExecStart=/home/yyc3/llama-factory-env/bin/python3 /home/yyc3/yyc3-102-projects/yyc3-family-ai-agents/governance_hub.py
WorkingDirectory=/home/yyc3/yyc3-102-projects/yyc3-family-ai-agents
Restart=always
RestartSec=5
StandardOutput=append:/home/yyc3/.nemoclaw/governance/hub.log
StandardError=append:/home/yyc3/.nemoclaw/governance/hub.log
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
