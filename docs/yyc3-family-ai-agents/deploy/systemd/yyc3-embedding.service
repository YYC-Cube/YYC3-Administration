[Unit]
Description=YYC3 Embedding Service (Qwen3-Embedding-8B)
After=network.target
Wants=network.target

[Service]
Type=simple
User=yyc3
Group=yyc3
Environment=EMBEDDING_MODEL_PATH=/home/yyc3/models/Qwen3-Embedding-8B
Environment=EMBEDDING_PORT=8100
Environment=EMBEDDING_MAX_BATCH=64
ExecStart=/home/yyc3/llama-factory-env/bin/python3 /home/yyc3/yyc3-102-projects/embedding_server.py
WorkingDirectory=/home/yyc3/yyc3-102-projects
Restart=always
RestartSec=10
StandardOutput=append:/home/yyc3/yyc3-102-projects/logs/embedding.log
StandardError=append:/home/yyc3/yyc3-102-projects/logs/embedding.log
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
